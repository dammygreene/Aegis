# Dynamic
DYNAMIC_AUTH_TOKEN=dyn_your_dynamic_auth_token_here
DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here

# Definitive Flash
DEFINITIVE_FLASH_API_KEY=dpka_your_flash_api_key_here

# Uniswap Developer Platform
UNISWAP_API_KEY=your_uniswap_api_key_here

# Alchemy RPC Endpoints
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Strict Hard Caps (Unsupervised Overnight Safety Gate)
MAX_LIVE_ORDER_USD=20
MAX_AGENT_SPEND_CAP_USD=50
